PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=dockslot_db
DATABASE_URL="mysql://root:your_db_password@localhost:3306/dockslot_db"
JWT_SECRET=your_jwt_secret_key
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Horizontal Scaling / Deployment
# ---------------------------------------------------------------------------
# Number of trusted proxy hops (or "true"/"false", or a comma-separated list of
# subnets/IPs) between the load balancer and this app. Required in production so
# `req.ip` reflects the real client for IP-keyed rate limiting and logs.
# Leave unset for direct/local access.
# TRUST_PROXY=1
#
# Prisma pool sizing: each instance opens its own DB pool. With N instances the
# total must stay under MySQL max_connections, so cap it explicitly, e.g.:
# DATABASE_URL="mysql://user:pass@host:3306/dockslot_db?connection_limit=10"
#
# In production, Redis is a SHARED, REQUIRED dependency: rate limits, session
# revocation (tokenVersion) and the isActive cache rely on it across instances.
# The in-memory Redis fallback is automatically disabled when NODE_ENV=production.
#
# On boot the first Redis command (e.g. the rate-limit store's SCRIPT LOAD) waits
# up to REDIS_READY_TIMEOUT_MS for the initial connection before falling back or
# failing fast, which avoids racing the asynchronous TCP handshake.
# REDIS_READY_TIMEOUT_MS=3000

# Token Lifetimes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Refresh Token HttpOnly Cookie
# Cookie name / scope. The refresh cookie is only sent to these auth endpoints.
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_PATH=/api/auth
# Force the Secure flag (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
# lax | strict | none   (use "none" + COOKIE_SECURE=true for cross-site deployments)
COOKIE_SAME_SITE=lax

# Comma-separated list of allowed browser origins for credentialed CORS.
# Leave unset to reflect the request origin (development default).
# CORS_ORIGIN=http://localhost:5173

# Rate Limiting Configuration (Time window in milliseconds, e.g., 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100            # Max 100 general API requests per user/IP per window
RATE_LIMIT_BOOKING_MAX=10         # Max 10 booking requests per user per window
RATE_LIMIT_2FA_MAX=5              # Max 5 two-factor code submissions per IP per window

# Security / Login Lockout Configuration
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# Mail & Notification Config (Mailhog SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="DockSlot <no-reply@dockslot.local>"
APP_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Transactional Outbox & Background Polling Worker
# ---------------------------------------------------------------------------
# Mock Carrier Notify API endpoint the outbox worker POSTs to
CARRIER_NOTIFY_URL=http://localhost:4001/notify
# Optional shared secret sent as "Authorization: Bearer <token>" (empty = not sent)
CARRIER_NOTIFY_TOKEN=
# Set to false to boot the API without the background dispatcher (e.g. during e2e tests)
OUTBOX_WORKER_ENABLED=true
# How often the worker polls the outbox for due events (ms)
OUTBOX_POLL_INTERVAL_MS=5000
# Max events claimed (and flipped to PROCESSING) per poll
OUTBOX_BATCH_SIZE=25
# Max webhook deliveries in flight at once within a claimed batch
OUTBOX_MAX_CONCURRENCY=5
# Max batches drained per poll cycle (bounds one cycle's runtime)
OUTBOX_MAX_BATCHES_PER_TICK=4
# Per-request webhook timeout; a timeout counts as a retryable failure (ms)
OUTBOX_REQUEST_TIMEOUT_MS=8000
# Delivery attempts before an event is parked as FAILED for admin review
OUTBOX_MAX_RETRIES=5
# Backoff = min(BACKOFF_BASE_MS * 2^retryCount, MAX_BACKOFF_MS) + up to 20% jitter
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_MAX_BACKOFF_MS=300000
# A PROCESSING event older than this is assumed orphaned and requeued (ms)
OUTBOX_PROCESSING_LEASE_MS=60000
