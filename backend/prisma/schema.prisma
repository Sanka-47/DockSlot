generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  WAREHOUSE_OPERATOR
  CARRIER
}

enum UserRole {
  WAREHOUSE_ADMIN
  DOCK_MANAGER
  CARRIER_ADMIN
  DISPATCHER
}

enum DockStatus {
  ACTIVE
  MAINTENANCE
}

enum BookingStatus {
  BOOKED
  CANCELLED
  ARRIVED
  NO_SHOW
  COMPLETED
}

model Organization {
  id        Int              @id @default(autoincrement())
  name      String
  type      OrganizationType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  users       User[]
  warehouses  Warehouse[]
  bookings    Booking[]    @relation("CarrierBookings")
  invitations Invitation[]

  @@map("organizations")
}

model User {
  id                   Int       @id @default(autoincrement())
  organizationId       Int
  email                String    @unique
  passwordHash         String
  role                 UserRole
  isActive             Boolean   @default(true)
  isEmailVerified      Boolean   @default(false)
  verificationToken    String?   @unique
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  failedLoginAttempts  Int       @default(0)
  lockUntil            DateTime?
  totpSecret           String?
  isTwoFactorEnabled   Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model Warehouse {
  id                Int      @id @default(autoincrement())
  organizationId    Int
  name              String
  address           String
  timezone          String
  slotLengthMinutes Int      @default(30)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docks          Dock[]
  operatingHours OperatingHour[]
  policy         WarehousePolicy?

  @@index([organizationId])
  @@map("warehouses")
}

model Dock {
  id          Int        @id @default(autoincrement())
  warehouseId Int
  name        String
  status      DockStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  closures  DockClosure[]

  @@index([warehouseId])
  @@map("docks")
}

model DockClosure {
  id        Int      @id @default(autoincrement())
  dockId    Int
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now())

  dock      Dock     @relation(fields: [dockId], references: [id], onDelete: Cascade)

  @@index([dockId])
  @@index([dockId, startTime, endTime], map: "dock_closures_active_check_idx")
  @@map("dock_closures")
}

model OperatingHour {
  id                Int      @id @default(autoincrement())
  warehouseId       Int
  dayOfWeek         Int
  openTime          String
  closeTime         String
  slotLengthMinutes Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@map("operating_hours")
}

model Booking {
  id            Int           @id @default(autoincrement())
  dockId        Int
  carrierOrgId  Int
  slotStartTime DateTime
  slotEndTime   DateTime
  truckPlate    String?
  driverName    String?
  driverPhone   String?
  cargoNote     String?       @db.Text
  status        BookingStatus @default(BOOKED)
  activeLock    String?       @default("ACTIVE") @db.VarChar(50)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  dock       Dock         @relation(fields: [dockId], references: [id], onDelete: Cascade)
  carrierOrg Organization @relation("CarrierBookings", fields: [carrierOrgId], references: [id], onDelete: Cascade)
  auditLogs  AuditLog[]

  @@unique([dockId, slotStartTime, activeLock])
  @@index([dockId])
  @@index([carrierOrgId])
  @@map("bookings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  bookingId Int
  userId    Int
  action    String   // "CREATED", "RESCHEDULED", "CANCELLED", "STATUS_CHANGED"
  details   Json?    // Stores old vs new values, reason, etc.
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([userId])
  @@map("audit_logs")
}

/// Transactional Outbox: events are written in the same transaction as the
/// aggregate mutation, then dispatched to the carrier webhook by a background
/// polling worker with exponential backoff.
model OutboxEvent {
  id            Int      @id @default(autoincrement())
  eventId       String   @unique @default(uuid()) // stable idempotency key sent as X-Event-Id to the receiver
  aggregateType String   // e.g., "BOOKING"
  aggregateId   Int      // Booking ID
  payload       Json     // Full event details (carrier org, booking info, message)
  status        String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  retryCount    Int      @default(0)
  maxRetries    Int      @default(5)
  nextRetryAt   DateTime @default(now())
  lastError     String?  @db.Text // populated on failure for administrative review
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  responseCode Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@map("idempotency_records")
}

model Invitation {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  organizationId Int
  role           String   // "DISPATCHER" or "DOCK_MANAGER"
  token          String   @unique
  expiresAt      DateTime
  status         String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model WarehousePolicy {
  id                     Int       @id @default(autoincrement())
  warehouseId            Int       @unique
  maxConcurrentBookings  Int       @default(3)
  maxAdvanceDays         Int       @default(14)
  bookingLockWindowHours Int       @default(24)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  warehouse              Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("warehouse_policies")
}


